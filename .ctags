--langdef=Clojure
--exclude=.git
--exclude=.svn
--exclude=*.ctags
--exclude=*/public/*
--exclude=.repl/*
--exclude=*/.repl/*
--exclude=out/*
--exclude=*/out/*
--exclude=target/*
--exclude=*/target/*
--exclude=*min.js
--langmap=Clojure:.clj.cljc.cljs
--regex-clojure=/\([ \t]*defmulti[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/x,multimethod definition/
--regex-clojure=/\([ \t]*defmethod[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/y,multimethod instance/
--regex-clojure=/\[[ \t]*([-[:alnum:]<>*+!_:\/.?]+)[ \t]+:as[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\2/a,alias/
--regex-clojure=/\([ \t]*def[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/d,definition/
--regex-clojure=/\([ \t]*definline[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/i,inline/
--regex-clojure=/\([ \t]*defmacro[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/m,macro/
--regex-clojure=/\([ \t]*defonce[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/o,definition (once)/
--regex-clojure=/\([ \t]*defn[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/f,function/
--regex-clojure=/\([ \t]*defn-[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/p,private function/
--regex-clojure=/\([ \t]*defprotocol[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/P,protocol definition/
--regex-clojure=/\([ \t]*definterface[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/I,interface definition/
--regex-clojure=/\([ \t]*defrecord[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/R,record/
--regex-clojure=/\([ \t]*defstruct[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/S,struct/
--regex-clojure=/\([ \t]*deftype[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/T,type/
--regex-clojure=/\([ \t]*intern[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/v,intern/
--regex-clojure=/\([ \t]*ns[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/n,namespace/
--regex-clojure=/\([ \t]*in-ns[ \t]+'([-[:alnum:]<>*+!_:\/.?]+)/\1/r,namespace/
--regex-clojure=/\([ \t]*create-ns[ \t]+'([-[:alnum:]<>*+!_:\/.?]+)/\1/N,namespace/
--regex-clojure=/\([ \t]*def[a-z]*[ \t]+([-[:alnum:]<>*+!_:\/.?]+)/\1/z,symbol/